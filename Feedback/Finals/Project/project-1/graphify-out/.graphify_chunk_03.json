    },
    {
      "id": "water_dispenser_real_life_wiring_sensor_bracket",
      "label": "HC-SR04 Mounting Bracket",
      "file_type": "concept",
      "source_file": "/media/rollie/Storage/Documents/obsidian/acads/acads/Feedback/Finals/Project/project-1/water_dispenser_real_life_wiring.png",
      "source_location": "vertical gray pole x~2628-2650 spanning y~430-2060 with horizontal arm at sensor height",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Sensor mounted pointing straight down, centered over the glass, 5-10 cm above the highest water level used, so readings are stable and the tube stays outside the beam."
    },
    {
      "id": "water_dispenser_real_life_wiring_mosfet_module",
      "label": "Isolated MOSFET Driver Module (green PCB, screw terminal)",
      "file_type": "concept",
      "source_file": "/media/rollie/Storage/Documents/obsidian/acads/acads/Feedback/Finals/Project/project-1/water_dispenser_real_life_wiring.png",
      "source_location": "bbox (202,162)-(997,477): light-green PCB with dark 3-terminal screw block and small onboard chips (optocoupler, resistors)",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "water_dispenser_real_life_wiring_battery_pack",
      "label": "6 V Battery Pack (4xAA)",
      "file_type": "concept",
      "source_file": "/media/rollie/Storage/Documents/obsidian/acads/acads/Feedback/Finals/Project/project-1/water_dispenser_real_life_wiring.png",
      "source_location": "bbox (515,1602)-(1784,1876): wide red box with dark internal cell band, red/yellow wires descending to it",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Separate ~6 V battery pack keeps the pump load off USB/Arduino power so the Nano does not reset when the pump starts."
    },
    {
      "id": "water_dispenser_real_life_wiring_pump",
      "label": "Submersible Pump",
