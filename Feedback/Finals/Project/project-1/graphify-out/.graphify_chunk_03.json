      "label": "Glass with Water (level integrator / plant)",
      "file_type": "concept",
      "source_file": "/media/rollie/Storage/Documents/obsidian/acads/acads/Feedback/Finals/Project/project-1/water_dispenser_real_life_wiring.png",
      "source_location": "bbox (2080,997)-(2519,1671): tall gray glass outline with sky-blue water block (2168,1363)-(2431,1631)",
      "source_url": null,
