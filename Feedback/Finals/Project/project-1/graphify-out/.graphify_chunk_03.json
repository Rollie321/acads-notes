      "author": null,
      "contributor": null
    },
    {
      "id": "water_dispenser_real_life_wiring_ruler",
      "label": "Ruler taped inside the glass",
      "file_type": "concept",
      "source_file": "/media/rollie/Storage/Documents/obsidian/acads/acads/Feedback/Finals/Project/project-1/water_dispenser_real_life_wiring.png",
      "source_location": "tan tick marks at regular intervals along the inner left wall of the glass",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "water_dispenser_real_life_wiring_tube",
      "label": "Pump delivery tube",
      "file_type": "concept",
      "source_file": "/media/rollie/Storage/Documents/obsidian/acads/acads/Feedback/Finals/Project/project-1/water_dispenser_real_life_wiring.png",
      "source_location": "silver strip entering glass rim (2186,955)-(2203,1010) and gray line running from reservoir up to glass",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Water is delivered down the inner glass wall, outside the sensor beam, to avoid ripples and splashes that would disturb the ultrasonic reading."
    },
    {
      "id": "water_dispenser_real_life_wiring_start_button",
      "label": "Start button (green cap)",
      "file_type": "concept",
      "source_file": "/media/rollie/Storage/Documents/obsidian/acads/acads/Feedback/Finals/Project/project-1/water_dispenser_real_life_wiring.png",
      "source_location": "bbox (1046,698)-(1113,765): round bright-green cap on dark square base, on the breadboard",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "water_dispenser_real_life_wiring_mode_switch",
      "label": "Mode slide switch (open-loop / closed-loop select)",
      "file_type": "concept",
      "source_file": "/media/rollie/Storage/Documents/obsidian/acads/acads/Feedback/Finals/Project/project-1/water_dispenser_real_life_wiring.png",
      "source_location": "bbox ~(1060,905)-(1220,975): silver metal body with white slider, on the breadboard",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "GND position = closed-loop, otherwise open-loop; the slide switch lets the same hardware run both control modes so the effect of feedback can be compared directly."
    },
    {
      "id": "water_dispenser_real_life_wiring_ultrasonic_beam",
      "label": "Ultrasonic measurement beam (sensor to water surface)",
      "file_type": "concept",
      "source_file": "/media/rollie/Storage/Documents/obsidian/acads/acads/Feedback/Finals/Project/project-1/water_dispenser_real_life_wiring.png",
      "source_location": "dashed vertical line x~2271-2305 from HC-SR04 down into the glass to the water surface",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The sensor points straight down and measures distance d to the water surface; the controlled output is the level rise y = d0 - d, so the beam path must stay clear of the tube and glass walls."
    },
    {
      "id": "water_dispenser_real_life_wiring_two_separate_grounds",
      "label": "Two separate grounds (optocoupler isolation)",
      "file_type": "rationale",
      "source_file": "/media/rollie/Storage/Documents/obsidian/acads/acads/Feedback/Finals/Project/project-1/water_dispenser_real_life_wiring.png",
      "source_location": "embodied by the module wiring: Nano-side signal GND and battery-minus kept separate",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The driver module's optocoupler separates the signal side from the load side, so the Nano-side ground rail (Nano, HC-SR04, button, switch, module signal GND) and the battery minus are deliberately NOT joined; joining them would defeat the isolation that keeps pump electrical noise away from the Nano and sensor."
    }
  ],
